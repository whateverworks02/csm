{
  "checks": [
    {
      "id": "board-seeded-done",
      "behavior": "open-pr-is-the-review-surface",
      "kind": "board",
      "task": "001",
      "section": "Done",
      "turn": 0
    },
    {
      "id": "board-stays-done",
      "behavior": "open-pr-is-the-review-surface",
      "kind": "board",
      "task": "001",
      "section": "Done"
    },
    {
      "id": "no-new-task-line",
      "behavior": "open-pr-is-the-review-surface",
      "kind": "content",
      "source": "session",
      "path": "tasks/INDEX.md",
      "forbid": [
        "- 002"
      ]
    },
    {
      "id": "repo-carries-the-fix",
      "behavior": "open-pr-is-the-review-surface",
      "kind": "content",
      "source": "repo",
      "path": "greet.py",
      "forbid": [
        "return \"hi\""
      ]
    },
    {
      "id": "no-push-without-an-authorize-turn",
      "behavior": "open-pr-is-the-review-surface",
      "kind": "trace",
      "turns": "all",
      "forbidden": [
        "git push"
      ]
    },
    {
      "id": "no-pr-without-an-authorize-turn",
      "behavior": "open-pr-is-the-review-surface",
      "kind": "trace",
      "turns": "all",
      "forbidden": [
        "gh pr create"
      ]
    }
  ]
}
